# Node
node_modules/

# NB: package-lock.json is deliberately NOT ignored. mobile/ has one and the
# store-build workflows need it for a reproducible npm install.

# Editor / tool state
.claude/
.vscode/
.idea/

# OS
Thumbs.db
.DS_Store

# Build scratch
*.log

# Cowork sandbox leftovers. The FUSE mount that bridges this folder into a
# session permits create, write and rename but denies unlink, so any scratch
# file a session makes has to be deleted from Windows afterwards. Ignoring the
# pattern means a stray one can never ride along in a commit.
*.tmp
