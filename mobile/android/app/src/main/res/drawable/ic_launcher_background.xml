<?xml version="1.0" encoding="utf-8"?>
<!-- The green the sprout sits on, as a drawable rather than a flat colour so
     the launcher icon carries the same top-to-bottom gradient as the mark
     inside the app. Drawn across the full 108dp adaptive canvas — the OEM
     mask crops it, and there must be colour under every corner it keeps. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:startColor="#1F6F4A"
        android:endColor="#36A76F"
        android:angle="270" />
</shape>
